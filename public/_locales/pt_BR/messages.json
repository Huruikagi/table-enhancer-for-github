  "frozenRows": { "message": "Linhas fixas" },
  "hideColumn": {
    "message": "Ocultar coluna $NUMBER$",
    "placeholders": { "number": { "content": "$1" } }
  },
  "hideRow": {
    "message": "Ocultar linha $NUMBER$",
    "placeholders": { "number": { "content": "$1" } }
  },
  "invalidRegularExpression": { "message": "Expressão regular inválida" },

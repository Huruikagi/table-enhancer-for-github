  "saveDefault": { "message": "Salvar padrão" },
  "saved": { "message": "Salvo" },
  "saving": { "message": "Salvando..." },
  "showHidden": { "message": "Mostrar ocultos" },
  "showHiddenRowsAndColumns": { "message": "Mostrar linhas e colunas ocultas" },
  "sortByColumn": {
    "message": "Ordenar pela coluna $NUMBER$",
    "placeholders": { "number": { "content": "$1" } }

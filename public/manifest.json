{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "1.6.0",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "permissions": ["storage"],
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "web_accessible_resources": [
    { "resources": ["options.html"], "matches": ["https://github.com/*"] }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["page-data.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": ["https://github.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
